---
import { band } from '../lib/rank';
const { entry, n } = Astro.props;
const d = entry.data;
const sev = band(d.cvss, d.severity);
const label = sev === 'high' ? 'high' : sev === 'med' ? 'medium' : 'low';
---
<a class={`cve sev-${sev}`} href={`/disclosures/${entry.id}`}>
  <span class="rank">{String(n).padStart(2, '0')}</span>
  <span class="body">
    <span class="id">{d.cve}</span><span class="tgt">{d.target}</span>
    <span class="ttl">{d.title}</span>
    <span class="refs">
      {d.ghsa && <span><b>advisory</b> {d.ghsa}</span>}
      {d.cwe?.length > 0 && <span><b>cwe</b> {d.cwe.join(' · ')}</span>}
      {d.patched_in && <span><b>patched</b> {d.patched_in}</span>}
      {d.cna && <span><b>cna</b> {d.cna}</span>}
    </span>
  </span>
  <span class="sco">
    <span class="v">{d.cvss}</span>
    <span class="b">{label}{d.cvss_version ? ` · v${d.cvss_version}` : ''}</span>
  </span>
</a>
