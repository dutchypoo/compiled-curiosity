---
import { monthYear } from '../consts';
import { band } from '../lib/rank';
const { entry } = Astro.props;
const d = entry.data;
const href = `/disclosures/${entry.id}`;
const sev = band(d.cvss, d.severity);
const ref = (d.advisory_url as string).replace(/\/+$/, '').split('/').pop() ?? '';
const refLabel = /^GHSA/i.test(ref) ? ref : (ref ? `#${ref}` : '');
const kicker = d.cve ? `// ${d.cve}`
             : d.ghsa ? '// published advisory'
             : d.status === 'fixed' ? '// fixed by maintainer' : '';
---
<a class={`card${d.featured ? ' feat' : ''}`} href={href}>
  {kicker && <p class="kicker">{kicker}</p>}
  <div class="target">{d.target}</div>
  <h3>{d.title}</h3>
  {d.summary && <p class="desc">{d.summary}</p>}
  <div class="meta">
    {d.cve && <span class="pill cveid">{d.cve}</span>}
    {d.ghsa && !d.cve && <span class="pill ghsaid">{d.ghsa}</span>}
    <span class={`pill ${sev}`}>{d.severity}{d.cvss ? ` · ${d.cvss}` : ''}</span>
    <span class="pill done">{d.status}</span>
    {d.tags.slice(0, 2).map((t: string) => <span class="pill tag">{t}</span>)}
  </div>
  <div class="foot">
    <span>{[refLabel, monthYear(d.disclosed)].filter(Boolean).join(' · ')}</span>
    <span class="go">view &rarr;</span>
  </div>
</a>
