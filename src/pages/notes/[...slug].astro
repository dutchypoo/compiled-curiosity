---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('notes', ({ data }) => !data.draft);
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const iso = (x: Date) => x.toISOString().slice(0, 10);
---
<Base title={d.title} description={d.summary}>
  <article class="article">
    <a class="back" href="/notes">← notes</a>
    <h1>{d.title}</h1>
    <ul class="facts"><li><span class="k">date</span><span class="v">{iso(d.date)}</span></li></ul>
    <div class="prose"><Content /></div>
  </article>
</Base>
