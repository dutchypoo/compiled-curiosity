---
import Base from '../layouts/Base.astro';
import DisclosureCard from '../components/DisclosureCard.astro';
import CveRow from '../components/CveRow.astro';
import WriteupCard from '../components/WriteupCard.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../consts';
import { bySeverity, tally, score } from '../lib/rank';

const all = (await getCollection('disclosures', ({ data }) => !data.draft)).sort(bySeverity);
const cves = all.filter((e) => e.data.cve).sort((a, b) => score(b.data.cvss) - score(a.data.cvss));
const t = tally(all);
const wr = (await getCollection('writeups', ({ data }) => !data.draft))
  .sort((a, b) => +b.data.date - +a.data.date);
---
<Base>
  <section class="hero">
    <span class="eyebrow">// vulnerability research &amp; responsible disclosure</span>
    <h1><span class="hl">{t.cves} CVEs</span> and {t.advisories} GitHub Security Advisories<br />in open source software.</h1>
    <p class="lede">I hunt vulnerabilities in open source projects and report them to the
      maintainers. Fuzzing, source review, or black box testing, whatever the target
      needs. Everything below is public and verifiable.</p>

    <div class="score">
      <div class="stat p"><span class="n">{t.cves}</span><span class="l">CVEs assigned</span></div>
      <div class="stat"><span class="n">{t.advisories}</span><span class="l">GHSA advisories</span></div>
      <div class="stat"><span class="n">{t.total}</span><span class="l">public disclosures</span></div>
      <div class="stat"><span class="n">{t.projects}</span><span class="l">projects reported to</span></div>
    </div>
  </section>

  {cves.length > 0 && (
    <section id="cves">
      <div class="shead">
        <h2><span class="caret">&#9656;</span>cve registry</h2>
        <span class="more">ranked by CVSS</span>
      </div>
      <p class="snote">Every ID below resolves on cve.org. Click through for the root cause, the proof of concept and the fix commit.</p>
      <div class="reg">{cves.map((e, i) => <CveRow entry={e} n={i + 1} />)}</div>
    </section>
  )}

  <section id="disclosures">
    <div class="shead">
      <h2><span class="caret">&#9656;</span>all disclosures</h2>
      <span class="more"><a href="/disclosures">all {t.total} &rarr;</a></span>
    </div>
    <div class="grid">{all.slice(0, 6).map((e) => <DisclosureCard entry={e} />)}</div>
  </section>

  <section id="writeups">
    <div class="shead">
      <h2><span class="caret">&#9656;</span>writeups</h2>
      {wr.length > 0 && <span class="more"><a href="/writeups">all &rarr;</a></span>}
    </div>
    {wr.length > 0
      ? <div class="grid">{wr.slice(0, 4).map((e) => <WriteupCard entry={e} />)}</div>
      : <div class="empty">No writeups yet. Add one with <code>npm run new writeup "Room name"</code>, then set <code>draft: false</code>.</div>}
  </section>

  <section id="about" class="about">
    <div class="shead"><h2><span class="caret">&#9656;</span>about</h2></div>
    <p>I hunt vulnerabilities in open source software. Most of what I have found so far is
      memory safety bugs in C, but I am not tied to one language or one bug class. Web
      application testing is the part I enjoy most.</p>
    <p>I report to the maintainer, write the patch when I can, and say plainly what I
      verified and what I did not.</p>
    <div class="contacts">
      <a href={SITE.github}>github.com/dutchypoo &#8599;</a>
      <a href="/.well-known/security.txt">security.txt</a>
      <a href="/rss.xml">rss</a>
    </div>
  </section>
</Base>
